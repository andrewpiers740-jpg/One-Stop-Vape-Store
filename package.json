{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "crosscheck": "node scripts/crosscheck.mjs && node scripts/crosscheck-extra.mjs",
    "gen": "node scripts/gen-agent-files.mjs",
    "blog": "node scripts/build-blog.mjs",
    "images:products": "node scripts/images-products.mjs",
    "images:curated": "node scripts/images-curated.mjs",
    "images:blog": "node scripts/images-blog.mjs",
    "test": "node --import ./scripts/register-alias.mjs scripts/test-pricing.mjs && node --import ./scripts/register-alias.mjs scripts/test-crypto.mjs",
    "content:estimate": "node scripts/ai-content.mjs estimate",
    "content:products": "node scripts/ai-content.mjs products",
    "content:blog": "node scripts/ai-content.mjs blog",
    "content:merge": "node scripts/ai-content.mjs merge && node scripts/build-blog.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@upstash/redis": "^1.41.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^14.9.0",
    "next": "^15.4.9",
    "nodemailer": "^10.3.1",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
