# ── One Stop Vape Store — environment variables (set in Vercel → Settings → Environment Variables) ──

# REQUIRED — admin portal passcode (server only; never prefix with NEXT_PUBLIC_). There is NO default:
# if this is unset the /admin API answers 503.
ADMIN_PASSCODE=""

# REQUIRED for the dashboard to keep orders — Upstash Redis (Vercel → Storage → Create Database → Upstash Redis).
# Vercel adds these automatically when you connect the database (any prefix is detected):
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# (or KV_REST_API_URL / KV_REST_API_TOKEN)

# REQUIRED for emails (order confirmations, payment details, gift-card instructions, proof alerts) — any SMTP provider
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"One Stop Vape Store" <sales@onestopvapestore.com>'
# Where order / enquiry alerts go (defaults to SITE.contact.email)
ORDER_EMAIL=""

# Public site URL used in email links (defaults to https://<SITE.domain>)
SITE_URL="https://onestopvapestore.com"

# OPTIONAL — crypto
CRYPTO_QUOTE_CURRENCY="usd"      # CoinGecko currency code for live quotes
ETHERSCAN_API_KEY=""             # enables AUTOMATIC detection of BNB (BNB Smart Chain) payments; without it BNB is confirmed manually
SOLANA_RPC_URL=""                # optional private RPC for SOL / USDC-Solana detection (public RPC is used by default)

# OPTIONAL — long-form content generation (npm run content:products / content:blog). Local use only; do NOT add to Vercel.
ANTHROPIC_API_KEY=""
CONTENT_MODEL="claude-sonnet-5-5"

# tawk.to live chat (Dashboard > Administration > Channels > Chat Widget > "Direct Chat Link": tawk.to/chat/<PROPERTY_ID>/<WIDGET_ID>)
# (unused, set SITE.tawk in src/config/site.js) NEXT_PUBLIC_TAWK_PROPERTY_ID=
# (unused, set SITE.tawk in src/config/site.js) NEXT_PUBLIC_TAWK_WIDGET_ID=default
